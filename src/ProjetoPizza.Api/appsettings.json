{
  "ConnectionStrings": {
    "PostgreSql": "Host=localhost;Port=5432;Database=projeto_pizza;Username=projeto_pizza"
  },
  "Authentication": {
    "Authority": "",
    "Issuer": "ProjetoPizza.Api",
    "Audience": "projeto-pizza-web",
    "AccessTokenMinutes": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Backup": {
    "Directory": "backups",
    "PgDumpExecutable": "pg_dump",
    "AutomaticEnabled": false,
    "IntervalHours": 24,
    "RetentionCount": 30
  },
  "MenuMedia": {
    "Directory": "data/media",
    "PublicPath": "/media",
    "MaxFileBytes": 5242880
  },
  "Fiscal": {
    "Enabled": false,
    "Provider": "",
    "State": "",
    "Environment": "Homologation",
    "CertificatePath": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost"
}
